<section class="page-intro">
  <p class="eyebrow">[ 02 ] / SELECTED WORK</p>
  <h1>Things I've <em>built.</em></h1>
  <p>Some projects are worth a proper write-up. The smaller, stranger experiments usually end up over in <a href="/labs">Labs</a>.</p>
</section>
<section class="index-section" aria-label="Projects">
  <div class="section-heading"><span>Project index</span><span><%= projects.length %> entries</span></div>
  <div class="project-grid">
    <% projects.forEach(function(project, index) { %>
      <a class="content-card focus-frame project-card" href="/project/<%= encodeURIComponent(project.slug) %>">
        <div class="card-meta"><span>[ <%= String(index + 1).padStart(2, '0') %> ]</span><span><%= project.status %></span></div>
        <h2><%= project.title %></h2>
        <p><%= project.summary %></p>
        <div class="card-bottom"><div class="tags"><% (project.tags || []).forEach(function(tag){ %><span class="tag"><%= tag %></span><% }); %></div><span aria-hidden="true" class="card-arrow">↗</span></div>
      </a>
    <% }); %>
  </div>
</section>
