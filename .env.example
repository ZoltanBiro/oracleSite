# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# MongoDB (Labs section only — main site needs no DB)
# Local example: mongodb://127.0.0.1:27017/labs
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/labs
MONGO_URI=mongodb://127.0.0.1:27017/labs
