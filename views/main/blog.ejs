<div class="spec-line">Blog</div>
<h1>Writing, <span>occasionally.</span></h1>
<p class="lede">
  Mostly tech and infrastructure, sometimes hockey, no fixed schedule.
</p>

<div class="project-grid">
  <% posts.forEach(function(post) { %>
    <div class="panel">
      <span class="focus tl"></span><span class="focus tr"></span>
      <span class="focus bl"></span><span class="focus br"></span>

      <div class="panel-top">
        <h2 class="panel-title"><%= post.title %></h2>
        <span class="panel-readout"><%= post.date %></span>
      </div>

      <div class="tags" style="margin-bottom: 20px; border-top: none; padding-top: 0;">
        <% post.tags.forEach(function(tag) { %>
          <span class="tag"><%= tag %></span>
        <% }); %>
      </div>

      <% post.body.forEach(function(paragraph) { %>
        <p class="lede"><%= paragraph %></p>
      <% }); %>
    </div>
  <% }); %>
</div>

