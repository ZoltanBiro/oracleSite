<section class="page-intro detail-intro">
  <a class="back-link" href="/projects">← All projects</a>
  <p class="eyebrow">PROJECT REPORT / <%= project.status %></p>
  <h1><%= project.title %></h1>
  <p><%= project.summary %></p>
</section>
<div class="detail-grid">
  <aside class="content-card focus-frame detail-aside">
    <span class="small-label">PROJECT DETAILS</span>
    <p class="aside-label">Status</p><p class="aside-value"><%= project.status %></p>
    <p class="aside-label">Technologies</p>
    <div class="tags"><% (project.tags || []).forEach(function(tag) { %><span class="tag"><%= tag %></span><% }); %></div>
    <% if (project.links && project.links.demo) { %><a class="text-cta" href="<%= project.links.demo %>" target="_blank" rel="noopener noreferrer">Live demo ↗</a><% } %>
    <% if (project.links && project.links.repo && !project.links.repo.includes('YOUR-USERNAME')) { %><a class="text-cta" href="<%= project.links.repo %>" target="_blank" rel="noopener noreferrer">Repository ↗</a><% } %>
  </aside>
  <article class="content-card focus-frame prose-card">
    <span class="small-label">THE WRITE-UP</span>
    <% (project.body || []).forEach(function(paragraph) { %><p><%= paragraph %></p><% }); %>
  </article>
</div>
<div class="end-link"><a href="/projects">← Back to projects</a></div>
