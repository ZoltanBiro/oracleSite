<% const latestPosts = (locals.posts || []).slice(0, 4); %>
<section class="home-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="eyebrow">[ 01 ] &nbsp; / &nbsp; HELLO THERE</div>
    <h1 id="hero-title">Zoltan Biro<span class="hero-line">Builds things, writes about them, and occasionally gets lost in New Zork.</span></h1>
    <p class="hero-desc">A mix of software, curiosity, and slightly questionable side projects. This is my corner of the internet.</p>
    <a class="button button-primary" href="#explore">Explore the site <span aria-hidden="true">↘</span></a>
  </div>
  <figure class="hero-visual focus-frame">
    <img src="/assets/main/images/hero-mountains.webp" alt="Mountain range reflected in a lake at sunset" width="1206" height="692" fetchpriority="high">
    <figcaption><span>// YYC, CA</span><span>// EST. 2026</span></figcaption>
    <span class="image-counter">01 / 01</span>
  </figure>
</section>

<section class="bento-section" id="explore" aria-label="Explore the site">
  <div class="bento-grid">
    <article class="bento-card bento-feature focus-frame">
      <div class="bento-heading"><span>[ 02 ]<strong>Featured project</strong></span><a href="/projects">View all <span aria-hidden="true">→</span></a></div>
      <a class="feature-body" href="/nzt" aria-label="Open New Zork Times">
        <div class="feature-text"><h2>New Zork Times</h2><p>A newspaper experiment from New Zork. Real game data, fake news, questionable journalism.</p><div class="tags"><span class="tag">#ZORK</span><span class="tag">#WRITING</span><span class="tag">#GAMING</span></div></div>
        <img src="/assets/main/images/nzt-preview.webp" alt="Black-and-white fantasy newspaper illustration" width="522" height="423" loading="lazy">
      </a>
    </article>
    <article class="bento-card bento-writing focus-frame">
      <div class="bento-heading"><span>[ 03 ]<strong>Latest writing</strong></span><a href="/blog">View all <span aria-hidden="true">→</span></a></div>
      <% if (latestPosts.length) { %>
        <div class="writing-list">
          <% latestPosts.forEach(function(post) { %>
            <a href="/blog" class="writing-item"><time><%= post.date %></time><span><%= post.title %></span><span aria-hidden="true">↗</span></a>
          <% }); %>
        </div>
      <% } else { %>
        <p class="empty-note">Writing will appear here as soon as there's something to read.</p>
      <% } %>
    </article>
    <article class="bento-card bento-labs focus-frame">
      <div class="bento-heading"><span>[ 04 ]<strong>Labs</strong></span><a href="/labs">View all <span aria-hidden="true">→</span></a></div>
      <a class="mini-feature" href="/labs"><img src="/assets/main/images/labs-preview.webp" alt="Retro computer window with a smiling icon" width="484" height="516" loading="lazy"><div><h2>Small ideas, loosely held.</h2><p>A sandbox for experiments, tools, and oddly specific applications.</p><div class="tags"><span class="tag">#EXPERIMENTS</span><span class="tag">#TOOLS</span></div></div></a>
    </article>
    <article class="bento-card bento-about focus-frame">
      <div class="bento-heading"><span>[ 05 ]<strong>About</strong></span></div>
      <div class="mini-feature"><img src="/assets/main/images/about-preview.webp" alt="Person looking toward the mountains" width="498" height="453" loading="lazy"><div><p>Developer, tinkerer, note-taker, and occasional writer. Based in Calgary.</p><a class="text-cta" href="/about">More about me <span aria-hidden="true">→</span></a></div></div>
    </article>
    <article class="bento-card bento-resume focus-frame">
      <div class="bento-heading"><span>[ 06 ]<strong>Resume</strong></span></div>
      <div class="resume-mini"><img class="resume-icon-image" src="/assets/main/images/resume-icon.webp" width="246" height="300" loading="lazy" alt=""><p>Experience, skills, and the formal version.</p></div>
      <a class="text-cta" href="/resume">View resume <span aria-hidden="true">→</span></a>
    </article>
  </div>
</section>
