  const currentPage = locals.page || '';
%>

<div class="frame-corner tl"></div>
<div class="frame-corner tr"></div>
<div class="frame-corner bl"></div>
<div class="frame-corner br"></div>

<div class="hud top-left"><span class="dot"></span>zoltLand</div>
<div class="hud top-right">2026</div>
<div class="hud bottom-left">GSG</div>
<div class="hud bottom-right">v1.0</div>

<nav class="top-nav">
  <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Home</a>
  <a href="/about" class="<%= currentPage === 'about' ? 'active' : '' %>">About</a>
