<section class="labs-intro">
  <h1>Labs</h1>
  <p>
    A sandbox of small, low-traffic apps I've built to stay sharp technically —
    learning new tech, scratching personal itches, or just practicing fullstack work.
    These are experiments, not portfolio pieces: expect some to be unpolished or
    weirdly specific.
  </p>
</section>

<section class="labs-list">
  <% apps.forEach(function(app) { %>
    <article class="labs-card">
      <h2><a href="/labs/<%= app.slug %>"><%= app.name %></a></h2>
      <p><%= app.blurb %></p>
      <span class="labs-card__status labs-card__status--<%= app.status %>"><%= app.status %></span>
    </article>
  <% }); %>
</section>
