<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="<%= locals.pageDescription || 'Independent dispatches from the New Zork Times.' %>"
  >


  <title>
    <%= locals.pageTitle
      ? pageTitle + ' — New Zork Times'
      : 'New Zork Times'
    %>
  </title>


  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap"
    rel="stylesheet"
  >


  <link
    rel="stylesheet"
    href="/assets/nzt/css/style.css"
  >

</head>


<body class="nzt-site">

  <%- include('../nzt/partials/header') %>


  <main class="nzt-main">

    <%- body %>

  </main>


  <%- include('../nzt/partials/footer') %>


  <script src="/assets/nzt/js/nzt.js"></script>

</body>

</html>