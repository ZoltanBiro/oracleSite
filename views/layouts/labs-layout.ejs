<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111516">
  <meta name="description" content="<%= locals.pageDescription || 'Labs: small tools, experiments, and ongoing projects by Zoltan Biro.' %>">
  <title><%= locals.pageTitle || locals.title || 'Labs' %> · ZB.DEV</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/labs/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/assets/labs/favicon.svg">
  <script defer src="/assets/labs/js/labs.js"></script>
</head>
<body class="labs">
  <a class="labs-skip" href="#labs-main">Skip to content</a>
  <span class="labs-viewport-corner is-tl" aria-hidden="true"></span>
  <span class="labs-viewport-corner is-tr" aria-hidden="true"></span>
  <span class="labs-viewport-corner is-bl" aria-hidden="true"></span>
  <span class="labs-viewport-corner is-br" aria-hidden="true"></span>
  <%- include('../partials/labs/header') %>
  <main class="labs-content" id="labs-main">
    <%- body %>
  </main>
  <%- include('../partials/labs/footer') %>
</body>
</html>
